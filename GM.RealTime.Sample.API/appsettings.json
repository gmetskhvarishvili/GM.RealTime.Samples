{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Wolverine": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "gm-realtime-sample",
    "Audience": "gm-realtime-sample",
    "Key": "dev-only-signing-key-change-me-please-32bytes-min"
  },
  "Messaging": {
    "ServiceName": "GM.RealTime.Sample.API",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    }
  },
  "ProducerTopology": {
    "Routes": [
      {
        "MessageType": "GM.RealTime.Sample.Domain.Events.RealTimeMessageQueuedIntegrationEvent, GM.RealTime.Sample.Domain",
        "Exchange": "gm.events",
        "RoutingKey": "realtime.message.queued",
        "Kind": "Topic"
      }
    ]
  }
}
