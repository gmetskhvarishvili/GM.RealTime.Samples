<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- GM.RealTime brings IRealTimeSender + the connection registry; the SignalR Redis backplane
             (configured below) lets this headless worker reach clients connected to the API. -->
        <PackageReference Include="GM.RealTime" Version="1.1.0" />
        <PackageReference Include="GM.Caching.Redis" Version="1.0.0" />
        <PackageReference Include="GM.DistributedLock.Redis" Version="1.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GM.RealTime.Sample.Domain\GM.RealTime.Sample.Domain.csproj" />
        <ProjectReference Include="..\GM.RealTime.Sample.Persistence\GM.RealTime.Sample.Persistence.csproj" />
    </ItemGroup>

</Project>
